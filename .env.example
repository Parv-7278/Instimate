# ====================================================================
# INSTITUTION HUB — Environment Variable Configuration Template
# ====================================================================
# IMPORTANT SECURITY NOTICES:
#   1. Copy this file to .env.local for local development
#   2. NEVER commit .env.local or any file with real credentials
#   3. NEVER put real API keys, passwords, or tokens in this file
#   4. Replace every placeholder value before running the application
# ====================================================================

# ----------------------------------------------------------------
# Application
# ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ----------------------------------------------------------------
# Supabase PostgreSQL Database & Authentication
# Create a free project at https://supabase.com
# Dashboard → Settings → API → Project URL / anon key / service_role key
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key

# Server-only — NEVER expose this key to the browser or client bundles
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# ----------------------------------------------------------------
# Razorpay Payment Gateway (India — UPI, NetBanking, Cards)
# Test keys available at https://dashboard.razorpay.com/app/keys
# Do NOT put live keys here. Use .env.local with your real test keys.
# ----------------------------------------------------------------
# Public key_id is safe for the frontend (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace_with_your_razorpay_test_key_id

# Server-only — keep this secret, never expose to browser
RAZORPAY_KEY_ID=replace_with_your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# ----------------------------------------------------------------
# Transactional Email — Resend
# Get API key at https://resend.com
# ----------------------------------------------------------------
RESEND_API_KEY=replace_with_your_resend_api_key
RESEND_FROM_EMAIL=notifications@yourdomain.com

# ----------------------------------------------------------------
# Google Cloud — OAuth 2.0 & Classroom API
# Create credentials at https://console.cloud.google.com
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret

# ----------------------------------------------------------------
# WhatsApp Business Cloud API (Meta Graph API)
# Configure at https://developers.facebook.com/apps
# ----------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=replace_with_your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=replace_with_your_meta_graph_api_access_token
